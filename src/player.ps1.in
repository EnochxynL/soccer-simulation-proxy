param(
    [Parameter(ValueFromRemainingArguments = $true)]
    [string[]]$ArgsList
)

$libPath = "@LIBRCSC_LIBDIR@"
if ($libPath -and $libPath -notmatch "@.+@") {
    if ($env:PATH) {
        $env:PATH = "$libPath;$env:PATH"
    }
    else {
        $env:PATH = $libPath
    }
}

$dir = $PSScriptRoot
$player = Join-Path $dir "sample_player.exe"
$teamname = "TRAINER_MODE"
$serverAddr = "localhost"
$config = Join-Path $dir "player.conf"
$config_dir = Join-Path $dir "formations-dt"
$debugopt = @("--offline_logging", "--debug", "--debug_server_connect")

function Show-Usage {
    Write-Output "Usage: $($MyInvocation.MyCommand.Name) [options]"
    Write-Output "  --help"
    Write-Output "  -h, --host HOST"
    Write-Output "  -t, --teamname TEAMNAME"
}

function Require-Value([int]$Index, [string]$Name) {
    if ($Index -ge $ArgsList.Count) {
        Write-Error "missing value for $Name"
        Show-Usage
        exit 1
    }
}

$i = 0
while ($i -lt $ArgsList.Count) {
    $arg = $ArgsList[$i]
    switch ($arg) {
        "--help" {
            Show-Usage
            exit 0
        }
        "-h" {
            $i++; Require-Value $i $arg; $serverAddr = $ArgsList[$i]
        }
        "--host" {
            $i++; Require-Value $i $arg; $serverAddr = $ArgsList[$i]
        }
        "-t" {
            $i++; Require-Value $i $arg; $teamname = $ArgsList[$i]
        }
        "--teamname" {
            $i++; Require-Value $i $arg; $teamname = $ArgsList[$i]
        }
        default {
            Write-Error "invalid option: $arg"
            Show-Usage
            exit 1
        }
    }
    $i++
}

if (-not (Test-Path $player)) {
    Write-Error "cannot find executable: $player"
    exit 1
}

$opt = @(
    "-h", $serverAddr,
    "-t", $teamname,
    "--player-config", $config,
    "--config_dir", $config_dir
)
$opt += $debugopt
$opt += @("-n", "11")

Start-Process -FilePath $player -ArgumentList $opt | Out-Null
