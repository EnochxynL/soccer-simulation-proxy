set(_librsc_libdir "@LIBRCSC_LIBDIR@")

function(_collect_runtime_dependencies executables_var out_resolved_var out_unresolved_var)
  set(_runtime_search_dirs)
  if(DEFINED ENV{MSYSTEM_PREFIX})
    list(APPEND _runtime_search_dirs "$ENV{MSYSTEM_PREFIX}/bin")
  endif()
  if(DEFINED ENV{MINGW_PREFIX})
    list(APPEND _runtime_search_dirs "$ENV{MINGW_PREFIX}/bin")
  endif()
  if(EXISTS "${_librsc_libdir}")
    list(APPEND _runtime_search_dirs "${_librsc_libdir}")
  endif()

  file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${${executables_var}}
    RESOLVED_DEPENDENCIES_VAR _resolved_deps_local
    UNRESOLVED_DEPENDENCIES_VAR _unresolved_deps_local
    DIRECTORIES ${_runtime_search_dirs}
    PRE_EXCLUDE_REGEXES
      "api-ms-win-.*"
      "ext-ms-.*"
    POST_EXCLUDE_REGEXES
      ".*[\\/]Windows[\\/]System32[\\/].*"
      ".*[\\/]Windows[\\/]WinSxS[\\/].*"
  )

  list(FILTER _resolved_deps_local INCLUDE REGEX ".*[\\/](ucrt64|mingw64|clang64|clangarm64|clang32)[\\/]bin[\\/].*\\.dll$")

  set(${out_resolved_var} ${_resolved_deps_local} PARENT_SCOPE)
  set(${out_unresolved_var} ${_unresolved_deps_local} PARENT_SCOPE)
endfunction()

set(_exe_suffix "${CMAKE_EXECUTABLE_SUFFIX}")
if(_exe_suffix STREQUAL "")
  set(_exe_suffix ".exe")
endif()